# LiveKit Configuration
# Get these from: https://cloud.livekit.io/projects
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Recall.ai Configuration (for Zoom integration)
# Get your API key from: https://recall.ai/dashboard
# Only needed if using zoom_survey.py for Zoom meetings
RECALL_API_KEY=your_recall_api_key_here
RECALL_REGION=us-west-2  # Options: us-west-2, us-east-1, eu-central-1, ap-northeast-1
RECALL_RETENTION_DAYS=7  # Auto-delete recordings after N days (1-365, default: 7)
RECALL_DELETE_IMMEDIATELY=false  # Set to 'true' to delete recordings when survey ends

# Agent Configuration
AGENT_NAME=CommunityModerator
AGENT_IDENTITY=moderator-bot

# Survey Settings
MAX_TURN_DURATION=20
TURN_WARNING_DURATION=15
ENABLE_TURN_LIMITS=True
FORCE_INTERRUPT_ENABLED=True

# Topic Enforcement (disabled for survey mode)
DISCUSSION_TOPIC=Survey Questions
OFF_TOPIC_INTERRUPT_THRESHOLD=3
ENABLE_TOPIC_ENFORCEMENT=False

# Model Configuration
STT_MODEL=gpt-4o-transcribe
LLM_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash

# LLM Parameters
TEMPERATURE=0.0

# Grace Periods (seconds)
# FIRST_INTERRUPT_GRACE: silent grace after max_turn_duration before warning
# SECOND_INTERRUPT_GRACE: actual wrap-up time after gentle warning (verbal promise: "ten to fifteen seconds")
FIRST_INTERRUPT_GRACE=10
SECOND_INTERRUPT_GRACE=15

# Logging
LOG_LEVEL=INFO
